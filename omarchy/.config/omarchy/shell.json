{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "exec": "/home/adityaws/DOTfiles/scripts/speech_recognition/nemotron_dictation/shell_status.sh",
          "id": "nemotron_stt",
          "interval": 1,
          "onClick": "/home/adityaws/DOTfiles/scripts/speech_recognition/nemotron_dictation/toggle_nemotron.sh --power",
          "tooltip": "Nemotron STT (F4)",
          "type": "command"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "birthYear": 1995,
          "lifeExpectancy": 75
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy-pomodoro",
          "autoStartBreaks": true,
          "autoStartOnBoot": true,
          "showIconInBar": true,
          "showOnlyWhenRunning": false,
          "shortBreakMinutes": 5,
          "workMinutes": 25,
          "autoStartWork": true
        }
      ],
      "right": [
        {
          "id": "jankeesvw.notification-center"
        },
        {
          "exec": "/home/adityaws/DOTfiles/scripts/cpu_status.sh",
          "fontSize": 13,
          "id": "custom_cpu",
          "interval": 2,
          "onClick": "omarchy-launch-or-focus org.omarchy.btop 'ghostty --class=org.omarchy.btop --font-size=10 -e btop'",
          "tooltip": "CPU Usage",
          "type": "command"
        },
        {
          "exec": "/home/adityaws/DOTfiles/scripts/net_graph.sh",
          "fontSize": 12,
          "id": "custom_net",
          "interval": 2,
          "onClick": "omarchy-launch-or-focus org.omarchy.nload 'ghostty --class=org.omarchy.nload --font-size=10 -e nload'",
          "tooltip": "Network Flow",
          "type": "command"
        },
        {
          "exec": "/home/adityaws/DOTfiles/scripts/gamemode_status.sh",
          "fontSize": 13,
          "id": "gamemode",
          "interval": 2,
          "onClick": "/home/adityaws/DOTfiles/scripts/gamemode_toggle.sh",
          "tooltip": "Toggle Game Mode",
          "type": "command"
        },
        {
          "exec": "/home/adityaws/DOTfiles/scripts/breakmode_status.sh",
          "fontSize": 13,
          "id": "breakmode",
          "interval": 2,
          "onClick": "/home/adityaws/DOTfiles/scripts/break-monitor-toggle.sh",
          "tooltip": "Toggle Break Mode",
          "type": "command"
        },
        {
          "id": "omakdeconnect"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "adityaws.lock"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "adityaws.lock"
  ]
}
