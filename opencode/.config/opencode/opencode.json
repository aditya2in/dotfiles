{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "deepseek/deepseek-flash",
  "agent": {
    "plan": {
      "reasoningEffort": "high"
    },
    "build": {
      "reasoningEffort": "low"
    }
  },
  "instructions": [
    "AGENTS.md",
    "All Things/Agents/AGENTS.md",
    "All Things/Agents/Routine_OS/AGENTS.md"
  ],
  "skills": {
    "paths": [
      "/home/adityaws/.opencode/skills/obsidian-skills/skills"
    ]
  },
  "mcp": {
    "voicebox": {
      "type": "remote",
      "url": "http://127.0.0.1:17493/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp",
        "--executable-path",
        "/usr/bin/brave"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "ixlabs": {
      "type": "remote",
      "url": "https://labs.iximiuz.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {file:/home/adityaws/.config/mcp-secrets/ixlabs-token}"
      }
    }
  }
}
