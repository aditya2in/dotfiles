{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "deepseek/deepseek-flash",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "playwright_*": "deny"
  },
  "agent": {
    "browser-verify": {
      "description": "Browser anchor-verification (Playwright). Fetch a page and read its real heading ids (h2/h3 [id]) before a #anchor link is handed to Brave. Use ONLY for anchor verification.",
      "mode": "subagent",
      "permission": {
        "playwright_*": "allow"
      }
    }
  },
  "skills": {
    "paths": [
      "/home/adityaws/.opencode/skills/obsidian-skills/skills"
    ]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp",
        "--executable-path",
        "/usr/bin/brave"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "ixlabs": {
      "type": "remote",
      "url": "https://labs.iximiuz.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {file:/home/adityaws/.config/mcp-secrets/ixlabs-token}"
      }
    }
  }
}
