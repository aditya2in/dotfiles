/* --- General Waybar styling --- */
* {
  border: none;
  border-radius: 0;
  font-family: "MesloLGS NF", monospace;
  font-size: 13px; /* Slightly smaller font for a slimmer bar */
  min-height: 0;
}

window#waybar {
  background-color: rgba(30, 30, 46, 0.9);
  color: #cdd6f4;
  border-radius: 8px;
}

/* --- Color definitions (Catppuccin Macchiato Palette) --- */
@define-color base #1e1e2e;
@define-color mantle #181825;
@define-color crust #11111b;
@define-color text #cdd6f4;
@define-color subtext0 #a6adc8;
@define-color surface0 #313244;
@define-color surface1 #45475a;
@define-color surface2 #585b70;
@define-color blue #89b4fa;
@define-color red #f38ba8;
@define-color maroon #eba0ac;
@define-color peach #fab387;
@define-color green #a6e3a1;
@define-color lavender #b4befe;
@define-color yellow #f9e2af;
@define-color mauve #cba6f7; /* Adding mauve for more color options if needed */

/* --- Module specific styling --- */
#workspaces button {
  padding: 0 8px;
  background-color: @surface0;
  color: @subtext0;
  border-radius: 5px;
  margin: 3px 3px;
  transition: all 0.3s ease-in-out;
  font-size: 16px;
  min-width: 45px;
}

#workspaces button:hover {
  background-color: @surface1;
  color: @text;
}
#workspaces button.active {
  background-color: @blue;
  color: @crust;
  border-radius: 5px;
  box-shadow: 0 0 5px @blue;
}
#workspaces button.occupied {
  background-color: @surface2;
  color: @text;
}
#workspaces button.urgent {
  background-color: @red;
  color: @text;
}
#workspaces button.empty {
  background-color: @mantle;
  color: @subtext0;
}

#window {
  margin: 3px 3px;
  padding: 0 10px;
  background-color: @surface0;
  border-radius: 5px;
  font-weight: bold;
}

/* --- General styling for right-side modules --- */
#clock,
#battery,
#cpu,
#temperature,
#network,
#pulseaudio,
#tray,
#custom-memory {
  padding: 0 10px;
  background-color: @surface0;
  color: @text;
  margin: 3px 3px;
  border-radius: 5px;
}

/* --- Pomodoro Module Specifics --- */
#custom-pomodoro {
  /* CHANGED from #custom-pomo */
  /* General styling for the module */
  padding: 0 10px;
  margin: 3px 3px;
  border-radius: 5px;
  font-weight: bold;
  min-width: 150px; /* Give it a consistent width */
  transition: all 0.3s ease-in-out; /* Smooth transitions for color changes */
  background-color: @mantle; /* A neutral background */
  color: @subtext0; /* A neutral text color */
}

#custom-pomodoro.stopped {
  /* CHANGED from #custom-pomo.stopped */
  background-color: @red;
  color: @text;
  border-bottom: 2px solid @red;
  font-weight: bold;
  animation: attention-blink 1.5s ease-in-out infinite alternate;
  box-shadow: 0 0 15px @red;
  border-radius: 8px;
}

@keyframes attention-blink {
  from {
    background-color: @red;
    box-shadow: 0 0 15px @red;
  }
  to {
    background-color: @maroon;
    box-shadow: 0 0 20px @maroon;
  }
}

#custom-pomodoro.paused {
  /* CHANGED from #custom-pomo.paused */
  background-color: @yellow;
  color: @base;
  border-bottom: 2px solid @yellow;
  box-shadow: 0 0 5px @yellow;
}

#custom-pomodoro.running.work {
  /* CHANGED from #custom-pomo.running.work */
  background-color: @green;
  color: @base;
  border-bottom: 2px solid @green;
  box-shadow: 0 0 5px @green;
}

#custom-pomodoro.running.break {
  /* CHANGED from #custom-pomo.running.break */
  background-color: @lavender;
  color: @crust;
  border-bottom: 2px solid @lavender;
  box-shadow: 0 0 5px @lavender;
}

#custom-pomodoro.running.long-break {
  /* CHANGED from #custom-pomo.running.long-break */
  background-color: @blue;
  color: @crust;
  border-bottom: 2px solid @blue;
  box-shadow: 0 0 5px @blue;
}

/* Styling for the bracketed text parts using Pango markup */
#custom-pomodoro span.pomo-total {
  /* CHANGED from #custom-pomo span.pomo-total */
  color: @subtext0;
  font-weight: normal;
  opacity: 0.8;
}

#custom-pomodoro span.pomo-cycle {
  /* CHANGED from #custom-pomo span.pomo-cycle */
  color: @subtext0;
  font-weight: normal;
  opacity: 0.8;
}
