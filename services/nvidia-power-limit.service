[Unit]
Description=Set NVIDIA GPU Power Limit (235W) and Clock Clamp (1740MHz) (gpuworker01 - RTX 3080 Ti)
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
ExecStart=/usr/bin/nvidia-smi -pl 235
ExecStart=/usr/bin/nvidia-smi -lgc 210,1740
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
