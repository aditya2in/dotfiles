[Unit]
Description=Set NVIDIA GPU Power Limit (260W) and Clock Clamp (1800MHz) (gpuworker01 - RTX 3080 Ti)
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
ExecStart=/usr/bin/nvidia-smi -pl 260
ExecStart=/usr/bin/nvidia-smi -lgc 210,1800
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

